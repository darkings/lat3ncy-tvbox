<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueFrom="1.0" android:valueTo="1.06" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueFrom="1.0" android:valueTo="1.06" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="100" android:propertyName="scaleX" android:valueFrom="1.06" android:valueTo="1.0" />
            <objectAnimator android:duration="100" android:propertyName="scaleY" android:valueFrom="1.06" android:valueTo="1.0" />
        </set>
    </item>
</selector>
