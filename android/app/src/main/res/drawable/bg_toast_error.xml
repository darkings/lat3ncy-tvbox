<?xml version="1.0" encoding="utf-8"?>
<!-- 统一 Toast 背景（错误/失败提示）
     设计令牌: design-tokens.json
       容器色   = color.errorContainer   (#93000A) -> md3_error_container
       描边     = color.error            (#FFB4AB) -> md3_error, 1dp
       圆角     = shape.control          (12)      -> md3_corner_md
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/md3_error_container" />
    <corners android:radius="@dimen/md3_corner_md" />
    <stroke
        android:width="@dimen/md3_outline_stroke_width"
        android:color="@color/md3_error" />
</shape>
