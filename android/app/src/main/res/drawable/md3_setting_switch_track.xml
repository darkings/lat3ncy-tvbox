<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="@dimen/md3_setting_switch_width" android:height="@dimen/md3_setting_switch_height" />
            <corners android:radius="@dimen/md3_corner_full" />
            <solid android:color="@color/md3_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="@dimen/md3_setting_switch_width" android:height="@dimen/md3_setting_switch_height" />
            <corners android:radius="@dimen/md3_corner_full" />
            <solid android:color="@color/md3_surface_container_highest" />
            <stroke android:width="@dimen/md3_outline_stroke_width" android:color="@color/md3_outline" />
        </shape>
    </item>
</selector>
