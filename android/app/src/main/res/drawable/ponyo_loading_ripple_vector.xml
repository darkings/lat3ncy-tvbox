<?xml version="1.0" encoding="utf-8"?>
<!--
  Ponyo TV 缓冲涟漪 · 底图（珊瑚三环）
  色值取自 design-tokens.json：primary #F1A494 / primaryBright #F8BBAE
  环从半径 10 扩散到 20（viewBox 48，安全留边 4），动画只做 scale+alpha，
  不做 pathData 形变，避免播放中逐帧分配导致掉帧。
  ringC 做 2.5x → 1.0x 的反向收缩，错相位后可产生持续"呼吸"感。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:name="ponyoLoadingRoot"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 中心核：实心圆点，半径 3 -->
    <group android:name="core">
        <path
            android:name="corePath"
            android:pathData="M24,21 a3,3 0 1,1 0,6 a3,3 0 1,1 0,-6"
            android:fillColor="@color/md3_primary"
            android:fillAlpha="0.9" />
    </group>

    <!-- 涟漪环 A：半径 10，初始 alpha 0.55，向外扩散到半径 20 后淡出 -->
    <group
        android:name="ringA"
        android:pivotX="24"
        android:pivotY="24">
        <path
            android:name="ringAPath"
            android:pathData="M24,14 a10,10 0 1,1 0,20 a10,10 0 1,1 0,-20"
            android:strokeColor="@color/md3_primary_bright"
            android:strokeWidth="2.5"
            android:strokeAlpha="0.55"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent" />
    </group>

    <!-- 涟漪环 B：与 A 同形，动画错开 1/3 相位 -->
    <group
        android:name="ringB"
        android:pivotX="24"
        android:pivotY="24">
        <path
            android:name="ringBPath"
            android:pathData="M24,14 a10,10 0 1,1 0,20 a10,10 0 1,1 0,-20"
            android:strokeColor="@color/md3_primary_bright"
            android:strokeWidth="2.5"
            android:strokeAlpha="0.55"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent" />
    </group>

    <!-- 涟漪环 C：收缩环，起始即 2.5 倍大，向内收拢，形成呼吸节奏 -->
    <group
        android:name="ringC"
        android:pivotX="24"
        android:pivotY="24"
        android:scaleX="2.5"
        android:scaleY="2.5">
        <path
            android:name="ringCPath"
            android:pathData="M24,14 a10,10 0 1,1 0,20 a10,10 0 1,1 0,-20"
            android:strokeColor="@color/md3_primary_bright"
            android:strokeWidth="2.5"
            android:strokeAlpha="0"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent" />
    </group>
</vector>
