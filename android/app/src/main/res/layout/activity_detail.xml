<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/llLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 详情首屏：5:7，左侧海报/静音预览，右侧信息与操作。 -->
        <LinearLayout
            android:id="@+id/topLayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_330"
            android:layout_marginTop="@dimen/vs_10"
            android:layout_marginBottom="@dimen/vs_12"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_40"
            android:paddingRight="@dimen/vs_40">

            <FrameLayout
                android:id="@+id/detailHeroLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:layout_marginRight="@dimen/vs_20">

                <FrameLayout
                    android:id="@+id/thumbContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_detail_thumb_bg">

                    <ImageView
                        android:id="@+id/ivThumb"
                        android:layout_width="@dimen/poster_w"
                        android:layout_height="@dimen/vs_300"
                        android:layout_gravity="center"
                        android:background="@drawable/ponyo_poster_surface"
                        android:clipToOutline="true"
                        android:contentDescription="@string/cd_poster"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <!-- 预览开启时由 Java 切换为可见，用于保留左侧 5 列空间。 -->
                <View
                    android:id="@+id/previewPlayerPlace"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/detailInfoPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:background="@android:color/transparent"
                android:orientation="vertical"
                android:paddingLeft="@dimen/vs_20"
                android:paddingTop="@dimen/vs_16"
                android:paddingRight="@dimen/vs_20"
                android:paddingBottom="@dimen/vs_16">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_8"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:maxLines="2"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="@dimen/ts_28" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/vs_48"
                    android:layout_marginBottom="@dimen/vs_6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSite"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/vs_6"
                        android:background="@android:color/transparent"
                        android:ellipsize="middle"
                        android:gravity="center"
                        android:maxWidth="@dimen/vs_220"
                        android:maxLines="1"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvYear"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/vs_6"
                        android:background="@android:color/transparent"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxWidth="@dimen/vs_150"
                        android:maxLines="1"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvArea"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/vs_6"
                        android:background="@android:color/transparent"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxWidth="@dimen/vs_160"
                        android:maxLines="1"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvLang"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginRight="@dimen/vs_6"
                        android:background="@android:color/transparent"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxWidth="@dimen/vs_160"
                        android:maxLines="1"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:ellipsize="middle"
                        android:gravity="center"
                        android:maxWidth="@dimen/vs_220"
                        android:maxLines="1"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>

                <!-- 导演 + 演员 合并为一行：导演在前自适应宽度，演员占剩余宽度并超出截断 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/vs_6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDirector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvDirActorSep"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="false"
                        android:text="　"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="@dimen/ts_18"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvActor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:focusable="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/md3_on_surface_variant"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="2"
                    android:textColor="@color/md3_on_surface_variant"
                    android:textSize="@dimen/ts_22" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPlay"
                        android:layout_width="@dimen/md3_button_primary_min_width"
                        android:layout_height="@dimen/md3_button_height"
                        android:layout_marginRight="@dimen/vs_8"
                        android:background="@drawable/button_detail_play"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusUp="@id/previewPlayerBlock"
                        android:text="播放"
                        android:textColor="@color/md3_on_primary"
                        android:textSize="@dimen/ts_20" />

                    <TextView
                        android:id="@+id/tvQuickSearch"
                        android:layout_width="@dimen/md3_button_secondary_min_width"
                        android:layout_height="@dimen/md3_button_height"
                        android:layout_marginRight="@dimen/vs_8"
                        android:background="@drawable/button_detail_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusUp="@id/tvPlay"
                        android:text="快速搜索"
                        android:textColor="@color/md3_on_secondary_container"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvDesc"
                        android:layout_width="@dimen/md3_button_secondary_min_width"
                        android:layout_height="@dimen/md3_button_height"
                        android:layout_marginRight="@dimen/vs_8"
                        android:background="@drawable/button_detail_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusUp="@id/tvPlay"
                        android:text="简介"
                        android:textColor="@color/md3_on_secondary_container"
                        android:textSize="@dimen/ts_18" />

                    <TextView
                        android:id="@+id/tvCollect"
                        android:layout_width="@dimen/md3_button_secondary_min_width"
                        android:layout_height="@dimen/md3_button_height"
                        android:background="@drawable/button_detail_secondary"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:gravity="center"
                        android:nextFocusUp="@id/tvPlay"
                        android:text="收藏"
                        android:textColor="@color/md3_on_secondary_container"
                        android:textSize="@dimen/ts_18" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mEmptyPlaylist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="@dimen/vs_128"
                android:layout_height="@dimen/vs_128"
                android:src="@drawable/icon_empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_10"
                android:gravity="center"
                android:text="当前来源没有可播放线路"
                android:textColor="@color/md3_on_surface"
                android:textSize="@dimen/ts_24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_5"
                android:gravity="center"
                android:text="可以搜索其他来源"
                android:textColor="@color/md3_on_surface_variant"
                android:textSize="@dimen/ts_20" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vs_20"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mEmptyQuickSearch"
                    android:layout_width="@dimen/md3_button_primary_min_width"
                    android:layout_height="@dimen/md3_button_height"
                    android:layout_marginRight="@dimen/vs_10"
                    android:background="@drawable/button_detail_play"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:nextFocusRight="@id/mEmptyBack"
                    android:text="快速搜索"
                    android:textColor="@color/md3_on_primary"
                    android:textSize="@dimen/ts_20" />

                <TextView
                    android:id="@+id/mEmptyBack"
                    android:layout_width="@dimen/md3_button_secondary_min_width"
                    android:layout_height="@dimen/md3_button_height"
                    android:background="@drawable/button_detail_secondary"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:nextFocusLeft="@id/mEmptyQuickSearch"
                    android:text="返回详情"
                    android:textColor="@color/md3_on_secondary_container"
                    android:textSize="@dimen/ts_20" />
            </LinearLayout>
        </LinearLayout>

        <!-- 下半区固定层级：线路 → 分组/排序 → 选集。 -->
        <LinearLayout
            android:id="@+id/playlistPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/vs_40"
            android:layout_marginRight="@dimen/vs_40"
            android:layout_marginBottom="@dimen/vs_10"
            android:background="@android:color/transparent"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_16"
            android:paddingTop="@dimen/vs_10"
            android:paddingRight="@dimen/vs_16"
            android:paddingBottom="@dimen/vs_8">

            <TextView
                android:id="@+id/tvSourcesTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_28"
                android:gravity="center_vertical"
                android:text="线路"
                android:textColor="@color/md3_on_surface_variant"
                android:textSize="@dimen/ts_18" />

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewFlag"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_78"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:nextFocusUp="@id/previewPlayerBlock"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_selectedItemIsCentered="true" />

            <LinearLayout
                android:id="@+id/mSeriesGroupTv"
                android:layout_width="match_parent"
                android:layout_height="@dimen/md3_group_height"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                android:focusable="false">

                <TextView
                    android:id="@+id/tvSeriesGroupTitle"
                    android:layout_width="@dimen/vs_130"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="分组 / 排序"
                    android:textColor="@color/md3_on_surface_variant"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:id="@+id/mSeriesSortTv"
                    android:layout_width="@dimen/vs_100"
                    android:layout_height="match_parent"
                    android:background="@drawable/shape_detail_route"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusDown="@id/mGridView"
                    android:nextFocusRight="@id/mSeriesGroupView"
                    android:nextFocusUp="@id/mGridViewFlag"
                    android:singleLine="true"
                    android:text="正序"
                    android:textColor="@color/md3_on_surface"
                    android:textSize="@dimen/ts_18" />

                <com.owen.tvrecyclerview.widget.TvRecyclerView
                    android:id="@+id/mSeriesGroupView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_10"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:nextFocusDown="@id/mGridView"
                    android:nextFocusLeft="@id/mSeriesSortTv"
                    android:nextFocusUp="@id/mGridViewFlag"
                    app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                    app:tv_selectedItemIsCentered="true" />
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridViewQuality"
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_54"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:visibility="gone"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_selectedItemIsCentered="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/vs_32"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEpisodesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="选集"
                    android:textColor="@color/md3_on_surface_variant"
                    android:textSize="@dimen/ts_18" />

                <TextView
                    android:id="@+id/tvEpisodesLegend"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/vs_20"
                    android:gravity="center_vertical"
                    android:text="正在播放"
                    android:textColor="@color/md3_on_surface_variant"
                    android:textSize="@dimen/ts_16" />
            </LinearLayout>

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/mGridView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                app:tv_horizontalSpacingWithMargins="@dimen/vs_10"
                app:tv_selectedItemIsCentered="true"
                app:tv_verticalSpacingWithMargins="@dimen/vs_10" />
        </LinearLayout>
    </LinearLayout>

    <!-- 预览控件仍覆盖在左侧 5 列占位区，进入全屏时由 Java 改为 MATCH_PARENT。 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/previewPlayer"
        android:layout_width="@dimen/vs_470"
        android:layout_height="@dimen/vs_300"
        android:layout_marginStart="@dimen/vs_50"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/preview_player_round"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/previewPlayerBlock"
        android:layout_width="@dimen/vs_470"
        android:layout_height="@dimen/vs_300"
        android:layout_marginStart="@dimen/vs_50"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/preview_player_block"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/mGridViewFlag"
        android:nextFocusRight="@id/tvPlay"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPreviewHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="@dimen/vs_10"
            android:layout_marginBottom="@dimen/vs_5"
            android:background="@drawable/shape_detail_hint_bg"
            android:focusable="false"
            android:paddingLeft="@dimen/vs_8"
            android:paddingRight="@dimen/vs_8"
            android:paddingTop="@dimen/vs_2"
            android:paddingBottom="@dimen/vs_2"
            android:text="确定键全屏"
            android:textColor="@color/md3_on_surface"
            android:textSize="@dimen/ts_16" />
    </FrameLayout>

    <ImageView
        android:id="@+id/ivPreviewFallback"
        android:layout_width="@dimen/vs_470"
        android:layout_height="@dimen/vs_300"
        android:layout_marginStart="@dimen/vs_50"
        android:layout_marginLeft="@dimen/vs_50"
        android:layout_marginTop="@dimen/vs_20"
        android:background="@drawable/preview_player_round"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />
</FrameLayout>
