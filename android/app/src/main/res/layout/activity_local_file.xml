<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/g6_tool_page"
    android:paddingLeft="@dimen/vs_40"
    android:paddingTop="@dimen/vs_30"
    android:paddingRight="@dimen/vs_40"
    android:paddingBottom="@dimen/vs_30">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/g6_tool_panel"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:contentDescription="配置文件选择标题"
            android:textColor="@color/md3_on_surface"
            android:textSize="@dimen/ts_30" />

        <TextView
            android:id="@+id/tvPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:ellipsize="middle"
            android:singleLine="true"
            android:contentDescription="当前目录路径"
            android:textColor="@color/md3_on_surface_variant"
            android:textSize="@dimen/ts_20" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/vs_20"
            android:layout_weight="1">

            <com.owen.tvrecyclerview.widget.TvRecyclerView
                android:id="@+id/fileList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:paddingBottom="@dimen/vs_10"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="@dimen/md3_space_5"
                android:text="当前目录没有可用文件或文件夹"
                android:textColor="@color/md3_on_surface_variant"
                android:textSize="@dimen/ts_22"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
