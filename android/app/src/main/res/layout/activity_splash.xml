<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ponyo_splash_base"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- The solid root exactly matches the mandatory Android system splash. -->
    <View
        android:id="@+id/splash_scene"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@drawable/ponyo_splash_scene"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/splash_atmosphere"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/ponyo_splash_atmosphere"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/splash_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.52" />

    <LinearLayout
        android:id="@+id/splash_copy"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vs_120"
        android:layout_marginEnd="@dimen/vs_40"
        android:alpha="0"
        android:gravity="start"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/splash_split"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.48">

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.015"
            android:text="@string/app_name"
            android:textColor="@color/ponyo_splash_title"
            android:textSize="@dimen/ts_50"
            android:textStyle="bold" />

        <View
            android:id="@+id/splash_accent"
            android:layout_width="@dimen/vs_90"
            android:layout_height="@dimen/vs_3"
            android:layout_marginTop="@dimen/vs_16"
            android:background="@color/ponyo_splash_gold" />

        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_20"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:text="@string/splash_tagline"
            android:textColor="@color/ponyo_splash_tagline"
            android:textSize="@dimen/ts_28"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/splash_hero"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vs_38"
        android:layout_marginEnd="@dimen/vs_64"
        android:layout_marginBottom="@dimen/vs_20"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ponyo_splash_hero"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2249:1800"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/splash_split"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
