<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/vs_480"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/g6_dialog_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_36"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_36"
        android:paddingBottom="@dimen/vs_30">

        <TextView
            android:id="@+id/confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/dialog_text_primary"
            android:textSize="@dimen/ts_28"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/confirmBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_12"
            android:gravity="center"
            android:textColor="@color/dialog_text_hint"
            android:textSize="@dimen/ts_22" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_24"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_60"
                android:layout_marginRight="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/g6_dialog_secondary"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="取消"
                android:textColor="@color/md3_on_secondary_container"
                android:textSize="@dimen/ts_24" />

            <TextView
                android:id="@+id/btnConfirm"
                android:layout_width="0dp"
                android:layout_height="@dimen/vs_60"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/g6_dialog_danger"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="清空"
                android:textColor="@color/md3_error"
                android:textSize="@dimen/ts_24" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
