<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        简介弹窗对齐 design-tokens.json：
        dialogMinWidth=720 / dialogMaxWidth=880 / dialogMaxHeight=600
        shape.dialog=24 / spacing.xl=24 / type.title=24 / type.body=22
    -->
    <LinearLayout
        android:layout_width="@dimen/vs_720"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/g6_dialog_panel"
        android:elevation="@dimen/md3_elevation_3"
        android:maxWidth="@dimen/md3_dialog_max_width"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_36"
        android:paddingTop="@dimen/vs_30"
        android:paddingRight="@dimen/vs_36"
        android:paddingBottom="@dimen/vs_30">

        <TextView
            android:id="@+id/descTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="影片简介"
            android:textColor="@color/md3_on_surface"
            android:textSize="@dimen/ts_28"
            android:textStyle="bold" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/descScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_16"
            android:fadeScrollbars="true"
            android:fillViewport="false"
            android:scrollbarStyle="insideOverlay">

            <TextView
                android:id="@+id/describe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/md3_on_surface"
                android:textSize="@dimen/ts_22" />

        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/descClose"
            android:layout_width="@dimen/vs_200"
            android:layout_height="@dimen/md3_button_height"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/vs_24"
            android:background="@drawable/g6_dialog_primary"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:text="关闭"
            android:textColor="@color/md3_on_primary_container"
            android:textSize="@dimen/ts_24" />

    </LinearLayout>

</FrameLayout>
