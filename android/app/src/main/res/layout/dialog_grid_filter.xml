<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/filterRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/g6_dialog_filter_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingLeft="@dimen/vs_35"
        android:paddingTop="@dimen/vs_16"
        android:paddingRight="@dimen/vs_35"
        android:paddingBottom="@dimen/vs_16">

        <ScrollView
            android:id="@+id/filterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filterContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/md3_space_2" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/md3_outline_stroke_width"
            android:layout_marginTop="@dimen/md3_space_2"
            android:background="@color/md3_outline_variant" />
    </LinearLayout>
</FrameLayout>
