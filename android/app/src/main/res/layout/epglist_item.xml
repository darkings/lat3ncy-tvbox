<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cl_epg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_live_focus"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/md3_space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/touch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/md3_space_5"
            android:paddingTop="@dimen/md3_space_1"
            android:paddingEnd="@dimen/md3_space_2"
            android:paddingBottom="@dimen/md3_space_1">

            <TextView
                android:id="@+id/tv_epg_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md3_on_surface"
                android:textSize="@dimen/ts_16" />

            <com.github.tvbox.osc.ui.tv.widget.MarqueeTextView
                android:id="@+id/tv_epg_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:ellipsize="marquee"
                android:gravity="center_vertical|start"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="@color/md3_on_surface"
                android:textSize="@dimen/ts_18" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/live_now_chip"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/md3_space_6"
            android:layout_gravity="center_vertical"
            android:background="@drawable/live_epg_live_badge"
            android:gravity="center_vertical"
            android:minWidth="@dimen/md3_button_secondary_min_width"
            android:orientation="horizontal"
            android:paddingStart="@dimen/md3_space_2"
            android:paddingEnd="@dimen/md3_space_2"
            android:visibility="gone">

            <com.github.tvbox.osc.ui.tv.widget.AudioWaveView
                android:id="@+id/wqddg_AudioWaveView"
                android:layout_width="@dimen/md3_space_5"
                android:layout_height="@dimen/md3_space_3"
                android:layout_marginEnd="@dimen/md3_space_1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/shiyi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="直播中"
                android:textColor="@color/md3_on_primary"
                android:textSize="@dimen/ts_16" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/stateRail"
        android:layout_width="@dimen/md3_state_rail_width"
        android:layout_height="@dimen/md3_state_rail_height"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="@dimen/md3_state_rail_inset_start"
        android:background="@drawable/state_rail_primary"
        android:visibility="invisible" />
</FrameLayout>
