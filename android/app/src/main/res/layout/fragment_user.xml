<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="@dimen/vs_40"
    android:paddingRight="@dimen/vs_40">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/tvUserHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/shortcutScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/shortcutRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/md3_space_2"
                    android:paddingBottom="@dimen/md3_space_2">

            <LinearLayout
                android:id="@+id/tvHistory"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_56"
                android:layout_gravity="center"
                 android:layout_margin="@dimen/vs_4"
                android:background="@drawable/shape_home_action_focus"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                 android:paddingLeft="@dimen/vs_16"
                android:paddingTop="@dimen/vs_8"
                android:paddingRight="@dimen/vs_16"
                android:paddingBottom="@dimen/vs_8"
                 android:nextFocusRight="@id/tvLive"
                 android:nextFocusDown="@id/tvHotList">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/vs_24"
                    android:layout_height="@dimen/vs_24"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_history"
                    app:tint="@color/md3_icon_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="历史"
                    android:textAlignment="gravity"
                    android:textColor="@color/md3_action_text"
                    android:textSize="@dimen/ts_20" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvLive"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_56"
                android:layout_gravity="center"
                 android:layout_margin="@dimen/vs_4"
                android:background="@drawable/shape_home_action_focus"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_16"
                android:paddingTop="@dimen/vs_8"
                android:paddingRight="@dimen/vs_16"
                android:paddingBottom="@dimen/vs_8"
                 android:nextFocusLeft="@id/tvHistory"
                 android:nextFocusRight="@id/tvSearch"
                 android:nextFocusDown="@id/tvHotList">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/vs_24"
                    android:layout_height="@dimen/vs_24"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_live"
                    app:tint="@color/md3_icon_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="直播"
                    android:textAlignment="gravity"
                    android:textColor="@color/md3_action_text"
                    android:textSize="@dimen/ts_20" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvSearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_56"
                android:layout_gravity="center"
                 android:layout_margin="@dimen/vs_4"
                android:background="@drawable/shape_home_action_focus"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_16"
                android:paddingTop="@dimen/vs_8"
                android:paddingRight="@dimen/vs_16"
                android:paddingBottom="@dimen/vs_8"
                 android:nextFocusLeft="@id/tvLive"
                 android:nextFocusRight="@id/tvPush"
                 android:nextFocusDown="@id/tvHotList">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/vs_24"
                    android:layout_height="@dimen/vs_24"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_search"
                    app:tint="@color/md3_icon_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="搜索"
                    android:textAlignment="gravity"
                    android:textColor="@color/md3_action_text"
                    android:textSize="@dimen/ts_20" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvPush"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_56"
                android:layout_gravity="center"
                 android:layout_margin="@dimen/vs_4"
                android:background="@drawable/shape_home_action_focus"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_16"
                android:paddingTop="@dimen/vs_8"
                android:paddingRight="@dimen/vs_16"
                android:paddingBottom="@dimen/vs_8"
                 android:nextFocusLeft="@id/tvSearch"
                 android:nextFocusRight="@id/tvFavorite"
                 android:nextFocusDown="@id/tvHotList">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/vs_24"
                    android:layout_height="@dimen/vs_24"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_push"
                    app:tint="@color/md3_icon_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="推送"
                    android:textAlignment="gravity"
                    android:textColor="@color/md3_action_text"
                    android:textSize="@dimen/ts_20" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/tvFavorite"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_56"
                android:layout_gravity="center"
                 android:layout_margin="@dimen/vs_4"
                android:background="@drawable/shape_home_action_focus"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_16"
                android:paddingTop="@dimen/vs_8"
                android:paddingRight="@dimen/vs_16"
                android:paddingBottom="@dimen/vs_8"
                 android:nextFocusLeft="@id/tvPush"
                 android:nextFocusRight="@id/tvSetting"
                 android:nextFocusDown="@id/tvHotList">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/vs_24"
                    android:layout_height="@dimen/vs_24"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_collect"
                    app:tint="@color/md3_icon_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="收藏"
                    android:textAlignment="gravity"
                    android:textColor="@color/md3_action_text"
                    android:textSize="@dimen/ts_20" />

            </LinearLayout>

             <LinearLayout
                 android:id="@+id/tvSetting"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/vs_56"
                android:layout_gravity="center"
                android:layout_margin="@dimen/vs_4"
                android:background="@drawable/shape_home_action_focus"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:nextFocusLeft="@id/tvFavorite"
                 android:nextFocusUp="@id/tvFavorite"
                android:nextFocusDown="@id/tvHotList"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/vs_16"
                android:paddingTop="@dimen/vs_8"
                android:paddingRight="@dimen/vs_16"
                android:paddingBottom="@dimen/vs_8">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/vs_24"
                    android:layout_height="@dimen/vs_24"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_setting"
                    app:tint="@color/md3_icon_tint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginLeft="@dimen/vs_8"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:gravity="center"
                    android:text="设置"
                    android:textAlignment="gravity"
                    android:textColor="@color/md3_action_text"
                    android:textSize="@dimen/ts_20" />

            </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/tvHotList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_below="@+id/tvUserHome"
            app:tv_horizontalSpacingWithMargins="@dimen/vs_16"
            app:tv_selectedItemIsCentered="true"
            app:tv_verticalSpacingWithMargins="@dimen/vs_20"
            android:visibility="gone" />
    </RelativeLayout>

</RelativeLayout>
