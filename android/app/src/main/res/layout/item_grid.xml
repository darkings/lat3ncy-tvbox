<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/md3_poster_width"
    android:layout_height="@dimen/md3_poster_height"
    android:background="@drawable/ponyo_poster_surface"
    android:foreground="@drawable/md3_poster_card_state"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:stateListAnimator="@animator/poster_focus_scale">

    <FrameLayout
        android:id="@+id/mItemFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ponyo_poster_surface"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvYear"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/md3_poster_badge_height"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/md3_space_2"
            android:layout_marginTop="@dimen/md3_space_2"
            android:background="@drawable/md3_poster_badge"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="@dimen/md3_poster_width"
            android:paddingStart="@dimen/md3_space_2"
            android:paddingEnd="@dimen/md3_space_2"
            android:singleLine="true"
            android:textColor="@color/md3_on_surface"
            android:textSize="@dimen/md3_poster_badge_size"
            android:visibility="gone" />


        <FrameLayout
            android:id="@+id/posterScrim"
            android:layout_width="match_parent"
            android:layout_height="@dimen/md3_poster_scrim_height"
            android:layout_gravity="bottom"
            android:background="@drawable/md3_poster_scrim"
            android:paddingStart="@dimen/md3_space_2"
            android:paddingEnd="@dimen/md3_space_2"
            android:paddingTop="0dp"
            android:paddingBottom="@dimen/md3_space_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="bottom|start"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/md3_on_surface"
                    android:shadowColor="@color/md3_poster_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textSize="@dimen/md3_poster_title_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/md3_space_1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/md3_on_surface_variant"
                    android:shadowColor="@color/md3_poster_text_shadow"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textSize="@dimen/md3_poster_subtitle_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvActor"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
                <!-- Kept as compatibility bindings; poster cards no longer show year/area/lang stacks. -->
                <TextView
                    android:id="@+id/tvArea"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tvLang"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- 编辑/已选：整卡黑色遮罩，中间显示“已选”。 -->
        <FrameLayout
            android:id="@+id/delFrameLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/md3_poster_selected_scrim"
            android:visibility="gone">
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/selectionMark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="已选"
                android:textColor="@color/md3_on_surface"
                android:textSize="@dimen/md3_poster_title_size"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
