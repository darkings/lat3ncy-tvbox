<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/md3_setting_row_height"
    android:layout_marginBottom="@dimen/md3_space_2"
    android:background="@drawable/g6_tool_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/md3_space_5"
    android:paddingRight="@dimen/md3_space_5">

    <TextView
        android:id="@+id/tvType"
        android:layout_width="@dimen/vs_100"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:textColor="@color/md3_tertiary"
        android:textSize="@dimen/ts_22" />

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:ellipsize="middle"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:textColor="@color/md3_on_surface"
        android:textSize="@dimen/ts_24" />

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="@dimen/vs_220"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center_vertical|right"
        android:singleLine="true"
        android:textColor="@color/md3_on_surface_variant"
        android:textSize="@dimen/ts_20" />
</LinearLayout>
