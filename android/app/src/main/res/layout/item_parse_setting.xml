<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/button_danmu_setting"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/vs_50"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/vs_14"
    android:paddingRight="@dimen/vs_14">

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:textColor="@color/dialog_text_primary"
        android:textSize="@dimen/ts_22"
        tools:text="Ponyo解析（智能多解析）" />

    <TextView
        android:id="@+id/tvMark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:textColor="@color/md3_tertiary"
        android:textSize="@dimen/ts_26"
        tools:text="✓" />
</LinearLayout>