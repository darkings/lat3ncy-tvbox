<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/md3_poster_width"
    android:layout_height="@dimen/md3_poster_height"
    android:background="@drawable/ponyo_poster_surface"
    android:foreground="@drawable/md3_poster_card_state"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:stateListAnimator="@animator/poster_focus_scale">
    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ponyo_poster_surface"
        android:clipToOutline="true"
        android:scaleType="centerCrop" />
    <TextView
        android:id="@+id/tvSite"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/md3_poster_badge_height"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/md3_space_2"
        android:layout_marginTop="@dimen/md3_space_2"
        android:background="@drawable/md3_poster_badge"
        android:ellipsize="end"
        android:gravity="center"
        android:maxWidth="@dimen/md3_poster_width"
        android:paddingStart="@dimen/md3_space_2"
        android:paddingEnd="@dimen/md3_space_2"
        android:singleLine="true"
        android:textColor="@color/md3_on_surface"
        android:textSize="@dimen/md3_poster_badge_size" />
    <!-- 清晰度角标：右上角，显示当前源对该片的实测清晰度（4K/1080P/720P/标清）。默认 gone，查到后由 SearchAdapter 填入。 -->
    <TextView
        android:id="@+id/tvQuality"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/md3_poster_badge_height"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/md3_space_2"
        android:layout_marginEnd="@dimen/md3_space_2"
        android:background="@drawable/md3_poster_badge"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingStart="@dimen/md3_space_2"
        android:paddingEnd="@dimen/md3_space_2"
        android:singleLine="true"
        android:textColor="@color/md3_on_surface"
        android:textSize="@dimen/md3_poster_badge_size"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="1080P" />
    <FrameLayout
        android:id="@+id/posterScrim"
        android:layout_width="match_parent"
        android:layout_height="@dimen/md3_poster_scrim_height"
        android:layout_gravity="bottom"
        android:background="@drawable/md3_poster_scrim"
        android:paddingStart="@dimen/md3_space_2"
        android:paddingEnd="@dimen/md3_space_2"
        android:paddingTop="0dp"
        android:paddingBottom="@dimen/md3_space_2">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical">
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="bottom|start"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                android:textColor="@color/md3_on_surface"
                android:shadowColor="@color/md3_poster_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textSize="@dimen/md3_poster_title_size"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/md3_space_1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                android:textColor="@color/md3_on_surface_variant"
                android:shadowColor="@color/md3_poster_text_shadow"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textSize="@dimen/md3_poster_subtitle_size"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
