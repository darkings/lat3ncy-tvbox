<?xml version="1.0" encoding="utf-8"?>
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvSearchWord"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/bg_fast_search_word"
    android:ellipsize="marquee"
    android:focusable="true"
    android:marqueeRepeatLimit="marquee_forever"
    android:paddingLeft="@dimen/md3_space_3"
    android:paddingRight="@dimen/md3_space_3"
    android:paddingTop="@dimen/md3_space_2"
    android:paddingBottom="@dimen/md3_space_2"
    android:singleLine="true"
    android:textAlignment="center"
    android:textColor="@color/md3_on_surface"
    android:textSize="@dimen/ts_22"
    android:includeFontPadding="false" />
