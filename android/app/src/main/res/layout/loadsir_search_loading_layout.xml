<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="false"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:id="@+id/llLoadingContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 搜索页加载：使用搜索专用动画，避免误用换源/内容加载动画 -->
        <ProgressBar
            style="@style/PonyoLoading.Search.Page" />

        <TextView
            android:id="@+id/btnLoadingRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/md3_space_4"
            android:background="@drawable/g6_dialog_primary"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingLeft="@dimen/vs_24"
            android:paddingRight="@dimen/vs_24"
            android:paddingTop="@dimen/vs_8"
            android:paddingBottom="@dimen/vs_8"
            android:text="重试"
            android:textColor="@color/md3_on_primary"
            android:textSize="@dimen/ts_24"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
